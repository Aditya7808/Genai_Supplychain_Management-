# ── Database ──
DATABASE_URL=sqlite:///data/inventory.db

# ── OpenRouter (GenAI) ──
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,deepseek/deepseek-r1-distill:free,qwen/qwen3-32b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Vector DB (RAG) ──
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Data Paths ──
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
PROMOTIONS_CONTEXT_PATH=data/promotions_context

# ── App Config ──
APP_NAME=GenAI Inventory Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Forecasting ──
DEFAULT_FORECAST_HORIZON_DAYS=30
DEFAULT_FORECASTER=prophet
SAFETY_STOCK_MULTIPLIER=1.5
